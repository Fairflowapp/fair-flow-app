rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      let doc = firestore.get(/databases/(default)/documents/users/$(uid()));
      return doc == null ? null : doc.data;
    }

    function userRoleLower() {
      return userDoc() != null && userDoc().role is string ? userDoc().role.lower() : '';
    }

    function isManagerSalonStorage(salonId) {
      return signedIn()
        && userDoc() != null
        && userDoc().salonId == salonId
        && userRoleLower() in ['manager', 'admin', 'owner'];
    }

    // User private files
    match /users/{userId}/{allFiles=**} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // Salon brand logo (only for users in that salon)
    match /salons/{salonId}/brand/{allFiles=**} {
      allow read: if signedIn();
      allow write: if signedIn() && userDoc() != null && userDoc().salonId == salonId;
    }

    // Training images/videos — same as mediaWorks: any signed-in user can read/write.
    // PIN / multi-salon flows often lack users.salonId or role on members; strict checks caused storage/unauthorized.
    // Who may edit training *content* is enforced in Firestore (trainingItems), not here.
    match /salons/{salonId}/training/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Staff paths — split so sealed e-sign PDFs under documents/ are never
    // client-overwritable (Admin SDK / signed URL only). Overlapping Storage
    // rules OR together, so documents must NOT be covered by a broad write:true.
    function isSealedEsignFileName(name) {
      return name.matches('.*_signed\\.pdf')
        || name.matches('.*_certificate\\.pdf');
    }

    match /salons/{salonId}/staff/{staffId}/documents/{allPaths=**} {
      allow read: if signedIn();
      // Deny client write for sealed e-sign artifacts (…/{taskId}_signed.pdf /
      // …/{taskId}_certificate.pdf). Other staff-doc uploads remain allowed.
      allow write: if signedIn()
        && allPaths.size() > 0
        && !isSealedEsignFileName(allPaths[allPaths.size() - 1]);
    }

    match /salons/{salonId}/staff/{staffId}/{firstSegment}/{allPaths=**} {
      allow read, write: if signedIn() && firstSegment != 'documents';
    }

    match /salons/{salonId}/staff/{staffId}/{fileName} {
      allow read, write: if signedIn();
    }

    // Inbox response documents (manager uploads response file for document requests)
    match /salons/{salonId}/inboxDocuments/{allPaths=**} {
      allow read, write: if signedIn() && userDoc() != null && userDoc().salonId == salonId;
    }

    // Inventory order receipts / invoices (managers upload; salon members read)
    match /salons/{salonId}/inventory-order-documents/{docId}/{fileName} {
      allow read: if signedIn() && userDoc() != null && userDoc().salonId == salonId;
      allow write: if isManagerSalonStorage(salonId);
    }

    // Per-order receipts (multiple files under each order). Loose rule: any signed-in user of the salon
    // can upload; if userDoc is missing (PIN sessions etc.), signedIn is enough (matches staff-docs pattern).
    match /salons/{salonId}/inventoryOrders/{orderId}/receipts/{receiptId}/{fileName} {
      allow read, write: if signedIn();
    }

    // Legacy Media uploads (contentWorks) — files under media/{workId}/...
    match /salons/{salonId}/media/{workId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Media module (work photos). Match staff/ path: many PIN flows have users/{uid} without salonId;
    // strict salon match caused storage/unauthorized when salonId in app ≠ Firestore user doc.
    match /salons/{salonId}/mediaWorks/{workId}/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // Some clients / error URLs show lowercase path segment — allow same access
    match /salons/{salonId}/mediaworks/{workId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // ===== EMPLOYEE WRITE-UPS (confidential incident attachments) =====
    // Deliberately NOT under salons/{salonId}/staff/{staffId}/... — that path
    // above allows ANY signed-in user read/write, which must never apply to
    // write-up evidence. Access: owner / admin / permissions.writeups_manage
    // only (checked against Firestore). Managers and employees: no access.
    function writeupsStaffDocData(salonId) {
      return firestore.get(/databases/(default)/documents/salons/$(salonId)/staff/$(userDoc().staffId)).data;
    }

    function canManageWriteupsStorage(salonId) {
      return signedIn()
        && userDoc() != null
        && userDoc().salonId == salonId
        && (
          userRoleLower() in ['admin', 'owner']
          || (
            userDoc().staffId is string
            && firestore.exists(/databases/(default)/documents/salons/$(salonId)/staff/$(userDoc().staffId))
            && writeupsStaffDocData(salonId).get('permissions', {}) is map
            && writeupsStaffDocData(salonId).get('permissions', {}).get('writeups_manage', false) == true
          )
        );
    }

    match /salons/{salonId}/staffWriteups/{staffId}/incidents/{incidentId}/{fileName} {
      allow read: if canManageWriteupsStorage(salonId);
      // Uploads only — no client deletes/overwrites of evidence (request.resource
      // is null on delete, so deletes always fail). PDF or images, max 10 MB.
      allow write: if canManageWriteupsStorage(salonId)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
        );
    }

    // ===== TIME CLOCK PUNCH PHOTOS (Stage B) =====
    // Deliberately OUTSIDE salons/{salonId}/... — the staff/media paths above
    // allow ANY signed-in user read/write, which must never apply here.
    // Written ONLY by the timeClockPunch callable via the Admin SDK (bypasses
    // these rules); clients — including the kiosk and the photographed
    // employee — can never upload, replace or delete a punch photo.
    // Read: owner/admin or time_clock_manage holders (same audience as the
    // photo-failed alerts), following the writeups storage pattern.
    function timeClockStaffDocData(salonId) {
      return firestore.get(/databases/(default)/documents/salons/$(salonId)/staff/$(userDoc().staffId)).data;
    }

    function canManageTimeClockStorage(salonId) {
      return signedIn()
        && userDoc() != null
        && userDoc().salonId == salonId
        && (
          userRoleLower() in ['admin', 'owner']
          || (
            userDoc().staffId is string
            && firestore.exists(/databases/(default)/documents/salons/$(salonId)/staff/$(userDoc().staffId))
            && timeClockStaffDocData(salonId).get('permissions', {}) is map
            && timeClockStaffDocData(salonId).get('permissions', {}).get('time_clock_manage', false) == true
          )
        );
    }

    match /timeClockPhotos/{salonId}/{entryId}/{fileName} {
      allow read: if canManageTimeClockStorage(salonId);
      allow write: if false;
    }

    // Onboarding Portal uploads — signed URL / Admin SDK only (no client rules access)
    match /salons/{salonId}/onboarding-portal/{allPaths=**} {
      allow read, write: if false;
    }

    // E-sign signature library source PDFs — CF signed URL / Admin SDK only (E0+).
    // Sealed signed PDFs live under staff documents paths and are written by CF only in later phases.
    match /salons/{salonId}/onboarding-signature-library/{allPaths=**} {
      allow read, write: if false;
    }

    // deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
