{
  "name": "fair-flow-app-2",
  "version": "1.0.0",
  "main": "webflow-login-code.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "patch-package",
    "test:booking:static": "node scripts/run-booking-static-qa.js",
    "test:booking:static:policy": "node qa/scripts/verify-static-runner-policy.js",
    "test:booking:smart-scheduling:firestore-emulator": "node qa/scripts/run-env-dependent-booking-script.js scripts/test-booking-smart-scheduling-firestore-emulator.js",
    "test:booking:smart-scheduling:execute-booking-mutation": "node qa/scripts/run-env-dependent-booking-script.js scripts/test-booking-smart-scheduling-execute-booking-mutation.js",
    "test:booking:smart-scheduling:staging-callable": "node qa/scripts/run-env-dependent-booking-script.js scripts/test-booking-smart-scheduling-staging-callable.js",
    "test:booking:e2e": "playwright test --config qa/playwright.config.js --project=chromium",
    "test:booking:lifecycle": "FF_QA_SUITE=lifecycle playwright test --config qa/playwright.config.js --project=lifecycle",
    "test:booking:clients": "FF_QA_SUITE=clients playwright test --config qa/playwright.config.js --project=clients",
    "test:booking:time-block": "FF_QA_SUITE=time-block playwright test --config qa/playwright.config.js --project=time-block",
    "test:booking:recurring-flex": "FF_QA_SUITE=recurring-flex playwright test --config qa/playwright.config.js --project=recurring-flex",
    "test:booking:staging-write": "npm run test:booking:e2e && npm run test:booking:lifecycle && npm run test:booking:clients",
    "test:booking:regression": "node qa/scripts/run-booking-regression.js",
    "test:booking:regression:compare": "node qa/scripts/verify-baseline-compare.js",
    "test:booking:regression:slot-helper": "node qa/scripts/verify-slot-create-helper.js",
    "test:booking:regression:lock": "node qa/scripts/verify-write-lock.js",
    "test:booking:regression:cleanup-scope": "node qa/scripts/verify-cleanup-scope.js",
    "test:booking:cleanup-stale": "node qa/scripts/cleanup-stale-qa.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1"
  }
}
