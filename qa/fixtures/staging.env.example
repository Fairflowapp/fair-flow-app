# Copy to qa/fixtures/staging.env (gitignored) or export in your shell.
# NEVER put production credentials here.

# Required for authenticated Playwright smoke tests.
FF_STAGING_EMAIL=your-staging-user@example.com
FF_STAGING_PASSWORD=replace-with-staging-password-only

# Optional. Browser QA uses https://fair-flow-staging.web.app/?env=staging
# and serves this worktree's public/ files locally. A 127.0.0.1 value is
# upgraded to that staging origin because Auth blocks the local Referer.
# Production hosts are rejected.
# FF_BASE_URL=https://fair-flow-staging.web.app

# Optional local static-server port (default 4173).
# FF_QA_PORT=4173
